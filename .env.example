# Supabase Configuration
# You can set either SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY or VITE_ prefixed variables:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Invoice Workflow (server-side only)
# Anthropic extracts the uploaded PDF/image; no invoice row is written until approval.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Used to sign the short-lived extraction preview token. Use a long random value in production.
DRAFT_SIGNING_SECRET=replace-with-a-long-random-secret

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Standalone Dashboard App URL (optional cross-app navigation)
VITE_DASHBOARD_URL=http://localhost:5173

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here

# Google Workspace / Gmail OAuth 2.0 (Approach B)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret


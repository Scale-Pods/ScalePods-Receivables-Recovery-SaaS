# Supabase Configuration
# You can set either SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY or VITE_ prefixed variables:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Standalone Dashboard App URL (optional cross-app navigation)
VITE_DASHBOARD_URL=http://localhost:5173

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here

# Developer Role Whitelist (comma-separated emails or @domain)
VITE_DEVELOPER_EMAILS=admin@scalepods.com,dev@scalepods.com,@scalepods.com
